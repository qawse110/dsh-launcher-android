{
  "name": "dsh-prompt-optimizer-mobile",
  "version": "0.7.6-dshlauncher.1",
  "private": true,
  "description": "提示词优化（dsh-launcher fork）。基于 WestFox-AwA/dsh-prompt-optimizer v0.7.6，由 dsh-launcher-android 维护移动端适配：本部署**默认启用**（仅显式 enabled:false 才关闭）、视口感知面板尺寸、窄屏断点、安全区、触控人体工学。上游原版默认不启用，本 fork 依部署需要翻转该默认值。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "cordis": ">=4.0.0-rc <5"
  },
  "peerDependenciesMeta": {
    "cordis": {
      "optional": true
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "HELP-0.6.md",
    "HELP-0.6.en.md",
    "eval/HOLDOUT-v1.md",
    "eval/HOLDOUT-v2.md",
    "FORK.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "immediately": true
    }
  }
}
