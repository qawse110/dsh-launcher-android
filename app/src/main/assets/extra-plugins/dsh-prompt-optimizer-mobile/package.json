{
  "name": "dsh-prompt-optimizer-mobile",
  "version": "0.8.1-stable",
  "private": true,
  "description": "提示词优化。基于上游 WestFox-AwA/dsh-prompt-optimizer v0.8.1-stable，**本部署默认启用**：未配置即启用，仅显式 enabled:false 才关闭（上游原版默认不启用，本部署依需要翻转该默认值）。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "cordis": ">=4.0.0-rc <5"
  },
  "peerDependenciesMeta": {
    "cordis": {
      "optional": true
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "HELP-0.6.md",
    "HELP-0.6.en.md",
    "eval/HOLDOUT-v1.md",
    "eval/HOLDOUT-v2.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "react",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "immediately": true
    }
  }
}
